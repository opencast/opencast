meta {
  name: get_user_json
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/users/{{uUsername}}.json
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains json
}

tests {
  test("User JSON response should match the requesting username", function() {
    const body = res.getBody();
    expect(body).to.be.an('object');
    expect(body.user).to.be.an('object');
    expect(body.user.username).to.equal(bru.getVar("uUsername"));
    expect(body.user.name).to.be.a('string');
  });
}

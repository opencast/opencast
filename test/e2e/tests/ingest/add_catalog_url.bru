meta {
  name: add_catalog_url
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/ingest/addCatalog
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  flavor: dublincore/series
  url: {{catalogUrl_A}}
  mediaPackage: {{mediaPackage_A}}
}

assert {
  res.status: eq 200
}

tests {
  test("Add catalog by URL should return augmented mediapackage", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.include("<mediapackage");
    expect(body).to.include("type=\"dublincore/series\"");
  });
}

script:post-response {
  const body = res.getBody();
  bru.setVar("mediaPackage_A", body);
}

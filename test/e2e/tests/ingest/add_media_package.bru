meta {
  name: add_media_package
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/ingest/addMediaPackage
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  flavor: presentation/source
  title: Direct Ingest
  creator: Bruno Test
  BODY: @file(track.mp4)
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains xml
}

tests {
  test("Direct addMediaPackage should return workflow XML", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.match(/<(wf:)?workflow/);
    expect(body).to.include("state=\"INSTANTIATED\"");
    expect(body).to.include("schedule-and-upload");
  });
}

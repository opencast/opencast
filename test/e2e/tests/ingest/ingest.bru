meta {
  name: ingest
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/ingest/ingest
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  mediaPackage: {{mediaPackage_B}}
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains xml
}

tests {
  test("Ingest media package should start workflow and return workflow XML", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.match(/<(wf:)?workflow/);
    expect(body).to.include("state=\"INSTANTIATED\"");
    expect(body).to.include("schedule-and-upload");
  });
}

meta {
  name: ingest_wd_id
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/ingest/ingest/noop
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  mediaPackage: {{mediaPackage_C}}
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains xml
}

tests {
  test("Ingest media package with workflow ID should start noop workflow and return workflow XML", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.match(/<(wf:)?workflow/);
    expect(body).to.include("state=\"INSTANTIATED\"");
    expect(body).to.include("<wf:template>noop</wf:template>");
  });
}

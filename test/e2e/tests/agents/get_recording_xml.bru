meta {
  name: get_recording_xml
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/capture-admin/recordings/{{recordingMpId}}.xml
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Get recording status XML should return valid XML details", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.match(/<(ns2:)?recording-state-update/);
    expect(body).to.include(bru.getVar('recordingMpId'));
    expect(body).to.include("capturing");
  });
}

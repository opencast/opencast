meta {
  name: add_dc_catalog_for_recording
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/ingest/addDCCatalog
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  mediaPackage: {{recordingMpXml}}
  dublinCore: <?xml version="1.0" encoding="UTF-8"?><dublincore xmlns="http://www.opencastproject.org/xsd/1.0/dublincore/" xmlns:dcterms="http://purl.org/dc/terms/"><dcterms:title>Recording Event</dcterms:title><dcterms:creator>Bruno Test Suite</dcterms:creator><dcterms:spatial>{{recordingRoom}}</dcterms:spatial><dcterms:temporal>start=2036-06-05T10:00:00Z; end=2036-06-05T11:00:00Z; scheme=W3C-DTF</dcterms:temporal></dublincore>
  flavor: dublincore/episode
}

assert {
  res.status: eq 200
}

script:pre-request {
  const randomSuffix = Math.floor(Math.random() * 10000000);
  bru.setVar("recordingRoom", "room-rec-" + randomSuffix);
}

tests {
  test("Add Dublin Core catalog for recording schedule should succeed", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    bru.setVar("recordingMpXml", body);
  });
}

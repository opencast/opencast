meta {
  name: post_recording_state
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/capture-admin/recordings/{{recordingMpId}}
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  state: capturing
}

assert {
  res.status: eq 200
}

tests {
  test("Set recording status to capturing should succeed", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.include("set to capturing");
  });
}

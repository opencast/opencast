meta {
  name: get_episodes
  type: http
  seq: 2
}

get {
  url: {{searchBaseUrl}}/search/episode.json
  body: formUrlEncoded
  auth: inherit
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains json
}

tests {
  test("Search episodes list should have correct JAXB Jettison properties", function() {
    const body = res.getBody();
    expect(body).to.be.an('object');
    expect(body.offset).to.be.a('number');
    expect(body.limit).to.be.a('number');
    expect(body.total).to.be.a('number');
    expect(body.result).to.be.an('array');
  
    const getArray = (val) => {
      if (val === undefined || val === null) return [];
      return Array.isArray(val) ? val : [val];
    };
  
    body.result.forEach(item => {
      const mp = item.mediapackage;
      expect(mp).to.be.an('object');
      expect(mp.id).to.be.a('string');
      expect(mp.title).to.be.a('string');
      if (mp.duration) expect(mp.duration).to.be.a('number');
  
      if (mp.creators && mp.creators.creator) {
        const creators = getArray(mp.creators.creator);
        creators.forEach(c => expect(c).to.be.a('string'));
      }
  
      if (mp.media && mp.media.track) {
        const tracks = getArray(mp.media.track);
        tracks.forEach(track => {
          expect(track.id).to.be.a('string');
          expect(track.url).to.be.a('string');
          expect(track.type).to.be.a('string');
          if (track.tags && track.tags.tag) {
            const tags = getArray(track.tags.tag);
            tags.forEach(tag => expect(tag).to.be.a('string'));
          }
        });
      }
  
      if (mp.metadata && mp.metadata.catalog) {
        const catalogs = getArray(mp.metadata.catalog);
        catalogs.forEach(catalog => {
          expect(catalog.id).to.be.a('string');
          expect(catalog.url).to.be.a('string');
          expect(catalog.type).to.be.a('string');
        });
      }
  
      if (mp.attachments && mp.attachments.attachment) {
        const attachments = getArray(mp.attachments.attachment);
        attachments.forEach(attachment => {
          expect(attachment.id).to.be.a('string');
          expect(attachment.url).to.be.a('string');
          expect(attachment.type).to.be.a('string');
        });
      }
    });
  });
}

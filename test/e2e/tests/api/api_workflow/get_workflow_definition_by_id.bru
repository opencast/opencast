meta {
  name: get_workflow_definition_by_id
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/workflow-definitions/:workflowDefinitionId
  body: none
  auth: inherit
}

params:path {
  workflowDefinitionId: fast
}

assert {
  res.status: eq 200
}

tests {
  test("Workflow definition by ID should have correct types", function() {
    const item = res.getBody();
    expect(item).to.be.an('object');
    expect(item.title).to.be.a('string');
    expect(item.description).to.be.a('string');
    expect(item.tags).to.be.an('array');
    if (item.configuration_panel !== undefined) expect(item.configuration_panel).to.be.a('string');
    if (item.operations !== undefined) expect(item.operations).to.be.an('array');
  });
}

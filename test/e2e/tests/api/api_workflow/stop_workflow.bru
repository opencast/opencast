meta {
  name: stop_workflow
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/workflows/:workflowInstanceId
  body: formUrlEncoded
  auth: inherit
}

params:path {
  workflowInstanceId: {{workflowId}}
}

body:form-urlencoded {
  state: stopped
}

assert {
  res.status: eq 200
}

tests {
  test("Stopping the workflow should return the updated instance", function() {
    const item = res.getBody();
    expect(item).to.be.an('object');
    expect(item.state).to.be.a('string');
  });
}

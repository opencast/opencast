meta {
  name: put_series_acl
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/api/series/:seriesId/acl
  body: formUrlEncoded
  auth: inherit
}

params:path {
  seriesId: {{identifier}}
}

body:form-urlencoded {
  acl: [{"allow":true,"action":"read","role":"ROLE_USER"},{"allow":true,"action":"write","role":"ROLE_ADMIN"}]
  override: false
}

assert {
  res.status: eq 200
}

tests {
  test("Update series ACL response should have correct types", function() {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.be.an('array');
      body.forEach(function(ace) {
        expect(ace.allow).to.be.a('boolean');
        expect(ace.action).to.be.a('string');
        expect(ace.role).to.be.a('string');
      });
    }
  });
}

meta {
  name: get_series_by_id
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/series/:seriesId
  body: none
  auth: inherit
}

params:path {
  seriesId: {{identifier}}
}

assert {
  res.status: eq 200
}

tests {
  test("Series by ID properties should have correct types", function() {
    if (res.status === 200) {
      const item = res.getBody();
      expect(item).to.be.an('object');
      expect(item.identifier).to.be.a('string');
      expect(item.creator).to.be.a('string');
      expect(item.created).to.be.a('string');
      expect(item.title).to.be.a('string');
      expect(item.contributors).to.be.an('array');
      expect(item.publishers).to.be.an('array');
      expect(item.subjects).to.be.an('array');
      expect(item.organizers).to.be.an('array');
      expect(item.organization).to.be.a('string');
    }
  });
}

meta {
  name: post_url
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/security/sign
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  url: https://develop.opencast.org/
  valid-until: 2026-05-27T18:00:00Z
}

assert {
  res.status: eq 200
}

tests {
  test("Signed URL properties should have correct types", function() {
    if (res.status === 200) {
      const body = res.getBody();
      expect(body).to.be.an('object');
      if (body.error) {
        expect(body.error).to.be.a('string');
      } else {
        expect(body.url).to.be.a('string');
        expect(body['valid-until']).to.be.a('string');
      }
    }
  });
}

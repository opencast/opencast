meta {
  name: delete_agent
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/capture-admin/agents/test-agent-bruno
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Delete capture agent should succeed", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.include("test-agent-bruno removed");
  });
}

meta {
  name: post_agent
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/capture-admin/agents/test-agent-bruno
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  state: offline
  ~address: 127.0.0.1
}

assert {
  res.status: eq 200
}

tests {
  test("Set capture agent status should return success message", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.include("test-agent-bruno set to offline");
  });
}

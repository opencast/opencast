    <plugins>
      <plugin>
        <!-- use this to generate a code coverage report: -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <configuration>
          <skip>${maven.test.skip}</skip>
        </configuration>
        <executions>
          <execution>
            <id>check</id>
            <phase>site</phase>
            <goals>
              <goal>report-aggregate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>replace-site-jacoco</id>
            <goals>
              <goal>run</goal>
            </goals>
            <phase>site</phase>
            <configuration>
              <!-- this is a *horrible* hack, but jacoco's aggregate report doesn't actually aggregate see:
                https://github.com/jacoco/jacoco/wiki/MavenMultiModule
              So instead we blindly copy this project's reports to the parent's site -->
              <target name="Overwrite aggregate jacoco report">
                <copy todir="../../target/site/jacoco-aggregate">
                  <fileset dir="${project.build.directory}/site/jacoco-aggregate">
                    <include name="*"/>
                  </fileset>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

<?xml version="1.0"?>

<!DOCTYPE suppressions PUBLIC
    "-//Puppy Crawl//DTD Suppressions 1.1//EN"
    "http://www.puppycrawl.com/dtds/suppressions_1_1.dtd">

<suppressions>
    <suppress checks="LineLength" files="modules/admin-ui/.+\.(java|properties)"/>
    <suppress checks="LineLength" files="modules/caption-impl/.+\.(java|properties)"/>
    <suppress checks="LineLength" files="modules/capture-admin-service-impl/.+\.(java|properties)"/>
    <suppress checks="LineLength" files="modules/common/.+\.(java|properties)"/>

    <suppress checks="Indentation" files="modules/admin-ui/.+\.java"/>
    <suppress checks="Indentation" files="modules/capture-admin-service-impl/.+\.java"/>
    <suppress checks="Indentation" files="modules/common/.+\.java"/>
    <suppress checks="Indentation" files="modules/metadata/.+\.java"/>
    <suppress checks="Indentation" files="modules/serviceregistry/.+\.java"/>

    <suppress checks="(NeedBraces|LeftCurly)" files="modules/admin-ui/.+\.java"/>
    <suppress checks="(NeedBraces|LeftCurly)" files="modules/caption-impl/.+\.java"/>
    <suppress checks="(NeedBraces|LeftCurly)" files="modules/capture-admin-service-impl/.+\.java"/>
    <suppress checks="(NeedBraces|LeftCurly)" files="modules/common/.+\.java"/>
</suppressions>

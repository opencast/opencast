meta {
  name: post_schedule_for_Recording
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/ingest/schedule
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  mediaPackage: {{recordingMpXml}}
}

assert {
  res.status: in [200, 201]
}

tests {
  test("Schedule event for recording should succeed", function() {
    expect(res.status).to.be.oneOf([200, 201]);
  });
}

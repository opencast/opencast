meta {
  name: post_AgentConfiguration
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/capture-admin/agents/test-agent-bruno/configuration
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  configuration: <?xml version="1.0" encoding="UTF-8"?><!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd"><properties><entry key="capture.device.names">camera,screen</entry></properties>
}

assert {
  res.status: eq 200
}

tests {
  test("Set capture agent configuration should succeed and return XML details", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.match(/<(ns2:)?properties-response/);
    expect(body).to.include("capture.device.names");
    expect(body).to.include("camera,screen");
  });
}

meta {
  name: get_Agent_XML
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/capture-admin/agents/test-agent-bruno.xml
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("Get capture agent details in XML should return valid XML details", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.match(/<(ns2:)?agent-state-update/);
    expect(body).to.include("test-agent-bruno");
    expect(body).to.include("offline");
  });
}

meta {
  name: add_Track_URL
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/ingest/addTrack
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  flavor: presenter/source
  url: {{trackUrl_A}}
  mediaPackage: {{mediaPackage_A}}
}

assert {
  res.status: eq 200
}

tests {
  test("Add track by URL should return augmented mediapackage", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.include("<mediapackage");
    expect(body).to.include("type=\"presenter/source\"");
  });
}

script:post-response {
  const body = res.getBody();
  bru.setVar("mediaPackage_A", body);
}

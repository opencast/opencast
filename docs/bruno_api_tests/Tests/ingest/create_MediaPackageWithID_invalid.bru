meta {
  name: create_MediaPackageWithID_invalid
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/ingest/createMediaPackageWithID/%%invalid%%
  body: none
  auth: inherit
}

assert {
  res.status: eq 400
}

tests {
  test("Create MediaPackage with invalid ID should fail", function() {
    // Verifies that error is handled correctly and doesn't return 200
    expect(res.status).to.not.equal(200);
  });
}

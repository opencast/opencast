meta {
  name: add_PartialTrack_URL
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/ingest/addPartialTrack
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  flavor: presenter/source
  startTime: 10000
  url: {{partialTrackUrl_A}}
  mediaPackage: {{mediaPackage_A}}
}

assert {
  res.status: eq 200
}

tests {
  test("Add partial track by URL should return augmented mediapackage", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.include("<mediapackage");
  });
}

script:post-response {
  const body = res.getBody();
  bru.setVar("mediaPackage_A", body);
}

meta {
  name: add_MediaPackage_wdID
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/ingest/addMediaPackage/noop
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  flavor: presentation/source
  title: Direct Ingest Noop
  creator: Bruno Test
  BODY: @file(track.mp4)
}

assert {
  res.status: eq 200
  res.headers["content-type"]: contains xml
}

tests {
  test("Direct addMediaPackage with workflow ID should return noop workflow XML", function() {
    const body = res.getBody();
    expect(body).to.be.a('string');
    expect(body).to.match(/<(wf:)?workflow/);
    expect(body).to.include("state=\"INSTANTIATED\"");
    expect(body).to.include("<wf:template>noop</wf:template>");
  });
}
